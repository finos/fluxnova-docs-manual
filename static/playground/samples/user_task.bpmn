  <bpmn:process id="Process_1dxltk8" isExecutable="true" camunda:historyTimeToLive="1">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0sfcc4r</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0sfcc4r" sourceRef="StartEvent_1" targetRef="Activity_16mwm4q" />
    <bpmn:userTask id="Activity_16mwm4q" name="Review Request">
      <bpmn:incoming>Flow_0sfcc4r</bpmn:incoming>
      <bpmn:outgoing>Flow_0pz8aip</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0dcl8tl">
      <bpmn:incoming>Flow_0pz8aip</bpmn:incoming>
      <bpmn:outgoing>Flow_14x0fn1</bpmn:outgoing>
      <bpmn:outgoing>Flow_1b48chy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0pz8aip" sourceRef="Activity_16mwm4q" targetRef="Gateway_0dcl8tl" />
    <bpmn:sequenceFlow id="Flow_14x0fn1" sourceRef="Gateway_0dcl8tl" targetRef="Activity_1f9x0vb">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_1f9x0vb" name="Manager Approval">
      <bpmn:incoming>Flow_14x0fn1</bpmn:incoming>
      <bpmn:outgoing>Flow_1nxpx7a</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1b48chy" sourceRef="Gateway_0dcl8tl" targetRef="Activity_04agaiq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved==false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_04agaiq" name="Revise Review">
      <bpmn:incoming>Flow_1b48chy</bpmn:incoming>
      <bpmn:outgoing>Flow_1dov7fl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_17k7p4b">
      <bpmn:incoming>Flow_1nxpx7a</bpmn:incoming>
      <bpmn:incoming>Flow_1dov7fl</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1nxpx7a" sourceRef="Activity_1f9x0vb" targetRef="Event_17k7p4b" />
    <bpmn:sequenceFlow id="Flow_1dov7fl" sourceRef="Activity_04agaiq" targetRef="Event_17k7p4b" />
    <bpmn:textAnnotation id="TextAnnotation_18fjv5q">
      <bpmn:text>Process starts when a new request is submitted for review.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_183zq5g" associationDirection="None" sourceRef="StartEvent_1" targetRef="TextAnnotation_18fjv5q" />
    <bpmn:textAnnotation id="TextAnnotation_0lmsfnd">
      <bpmn:text>After claiming the task on Fluxnova tasklist, create a variable called 'approved'. Set its type to Boolean and either check(true) or uncheck(false) the box. Then complete the task </bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1x7bijv" associationDirection="None" sourceRef="Activity_16mwm4q" targetRef="TextAnnotation_0lmsfnd" />
    <bpmn:textAnnotation id="TextAnnotation_0n15zzp">
      <bpmn:text>If request is approved, proceed to manager approval. Otherwise, send for revision</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_117iocp" associationDirection="None" sourceRef="Gateway_0dcl8tl" targetRef="TextAnnotation_0n15zzp" />
    <bpmn:textAnnotation id="TextAnnotation_0q6a6eb">
      <bpmn:text>Manager reviews and gives final approval for the request</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1lo07z6" associationDirection="None" sourceRef="Activity_1f9x0vb" targetRef="TextAnnotation_0q6a6eb" />
    <bpmn:textAnnotation id="TextAnnotation_0c9pz9d">
      <bpmn:text>Request is sent back for corrections or additional information</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_07dkwpr" associationDirection="None" sourceRef="Activity_04agaiq" targetRef="TextAnnotation_0c9pz9d" />
    <bpmn:textAnnotation id="TextAnnotation_1pmc8jf">
      <bpmn:text>Process ends after final approval or revision is completed</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1mndia2" associationDirection="None" sourceRef="Event_17k7p4b" targetRef="TextAnnotation_1pmc8jf" />
  </bpmn:process>
