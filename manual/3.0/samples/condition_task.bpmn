    <bpmn:sequenceFlow id="Flow_0ye63th" sourceRef="Gateway_1lwuov5" targetRef="Activity_18exb24">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${input&gt;10}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0j4gdi8" sourceRef="Gateway_1lwuov5" targetRef="Activity_1ilqjpp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${input&lt;10}</bpmn:conditionExpression>
