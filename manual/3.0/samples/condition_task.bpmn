    <bpmn:textAnnotation id="TextAnnotation_1vepgrr">
      <bpmn:text>Process starts here. Triggered when the user begins the workflow.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0txzqh8" associationDirection="None" sourceRef="StartEvent_1" targetRef="TextAnnotation_1vepgrr" />
    <bpmn:textAnnotation id="TextAnnotation_1lkz15q">
      <bpmn:text>User is prompted to enter a value or answer a question.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_12gsfic" associationDirection="None" sourceRef="Activity_0jaujvt" targetRef="TextAnnotation_1lkz15q" />
    <bpmn:textAnnotation id="TextAnnotation_1ny1lq1">
      <bpmn:text>System checks the user input and decides the next path</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_177efkc" associationDirection="None" sourceRef="Gateway_1lwuov5" targetRef="TextAnnotation_1ny1lq1" />
    <bpmn:textAnnotation id="TextAnnotation_19bd7ro">
      <bpmn:text>If input is greater than 10, follow this path.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ni8li7" associationDirection="None" sourceRef="Flow_0ye63th" targetRef="TextAnnotation_19bd7ro" />
    <bpmn:textAnnotation id="TextAnnotation_14nvt6e">
      <bpmn:text>Handles the ‘Yes’ scenario where input satisfies the condition</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0iuhvjf" associationDirection="None" sourceRef="Activity_18exb24" targetRef="TextAnnotation_14nvt6e" />
    <bpmn:textAnnotation id="TextAnnotation_00bsyyj">
      <bpmn:text>“If input is less than 10, follow this path.”</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_18ourbq" associationDirection="None" sourceRef="Flow_0j4gdi8" targetRef="TextAnnotation_00bsyyj" />
    <bpmn:textAnnotation id="TextAnnotation_0rigu4n">
      <bpmn:text>Handles the ‘No’ scenario where input does not meet the condition.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_09acdno" associationDirection="None" sourceRef="Activity_1ilqjpp" targetRef="TextAnnotation_0rigu4n" />
    <bpmn:textAnnotation id="TextAnnotation_1ipiez7">
      <bpmn:text>Both paths converge here after processing.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1qmcplc" associationDirection="None" sourceRef="Activity_09uuxu3" targetRef="TextAnnotation_1ipiez7" />
    <bpmn:textAnnotation id="TextAnnotation_1omvv59">
