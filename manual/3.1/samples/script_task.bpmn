    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0ew6473" sourceRef="StartEvent_1" targetRef="Activity_0ejvb5e" />
    <bpmn:scriptTask id="Activity_0ejvb5e" name="Printing message" scriptFormat="groovy">
      <bpmn:incoming>Flow_0ew6473</bpmn:incoming>
      <bpmn:outgoing>Flow_18sb56x</bpmn:outgoing>
      <bpmn:script>def name = execution.getVariable("name")

if (name == null) {
    name = "User"
}

execution.setVariable("message", "Hello " + name + ", your request is approved.")
execution.setVariable("status", "approved")
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_18sb56x" sourceRef="Activity_0ejvb5e" targetRef="Activity_1mongr4" />
    <bpmn:userTask id="Activity_1mongr4" name="Viewed message">
      <bpmn:incoming>Flow_18sb56x</bpmn:incoming>
      <bpmn:outgoing>Flow_09kda1i</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_1eytrit">
      <bpmn:incoming>Flow_09kda1i</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_09kda1i" sourceRef="Activity_1mongr4" targetRef="Event_1eytrit" />
    <bpmn:textAnnotation id="TextAnnotation_17rci4l">
      <bpmn:text>Process starts when a request is initiated.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_17egb1d" associationDirection="None" sourceRef="StartEvent_1" targetRef="TextAnnotation_17rci4l" />
    <bpmn:textAnnotation id="TextAnnotation_0n8wr9d">
      <bpmn:text>A Groovy script fetches the user's name, assigns a default if missing, generates an approval message, and sets the status to "approved".</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0u6yndh" associationDirection="None" sourceRef="Activity_0ejvb5e" targetRef="TextAnnotation_0n8wr9d" />
    <bpmn:textAnnotation id="TextAnnotation_1tov0qr">
      <bpmn:text>User views the generated message and acknowledges it.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1xsnexp" associationDirection="None" sourceRef="Activity_1mongr4" targetRef="TextAnnotation_1tov0qr" />
    <bpmn:textAnnotation id="TextAnnotation_07tr7m3">
      <bpmn:text>Process ends after the user views the message.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1y0elwo" associationDirection="None" sourceRef="Event_1eytrit" targetRef="TextAnnotation_07tr7m3" />
