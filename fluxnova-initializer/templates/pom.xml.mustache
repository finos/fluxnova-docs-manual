<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>{{springBootVersion}}</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	
	<groupId>{{groupId}}</groupId>
	<artifactId>{{artifactId}}</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>{{projectName}}</name>
	<description>FINOS Fluxnova Spring Boot Application generated by Fluxnova Initializer</description>
	
	<properties>
		<java.version>21</java.version>
		<fluxnova.version>{{fluxnovaVersion}}</fluxnova.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.finos.fluxnova.bpm</groupId>
				<artifactId>fluxnova-bom</artifactId>
				<version>${fluxnova.version}</version>
				<scope>import</scope>
				<type>pom</type>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Engine Starter -->
		<dependency>
			<groupId>org.finos.fluxnova.bpm.springboot</groupId>
			<artifactId>fluxnova-bpm-spring-boot-starter</artifactId>
		</dependency>
		
		{{#features.cockpit}}
		<!-- Webapps (Cockpit, Tasklist, Admin) -->
		<dependency>
			<groupId>org.finos.fluxnova.bpm.springboot</groupId>
			<artifactId>fluxnova-bpm-spring-boot-starter-webapp</artifactId>
			<version>${fluxnova.version}</version>
		</dependency>
		{{/features.cockpit}}

		{{#features.restApi}}
		<!-- REST API -->
		<dependency>
			<groupId>org.finos.fluxnova.bpm.springboot</groupId>
			<artifactId>fluxnova-bpm-spring-boot-starter-rest</artifactId>
			<version>${fluxnova.version}</version>
		</dependency>
		{{/features.restApi}}

		<!-- Database dependencies -->
		{{#isH2}}
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		{{/isH2}}
		{{#isMysql}}
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
		</dependency>
		{{/isMysql}}
		{{#isPostgresql}}
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		{{/isPostgresql}}

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
